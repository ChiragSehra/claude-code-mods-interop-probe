# ---- Node / package managers ----
node_modules/
.npm/
.pnpm-store/
.pnpm-debug.log
*.tsbuildinfo
.eslintcache

# ---- Secrets & local env ----
.env
.env.*
*.local

# ---- Logs & temp files ----
