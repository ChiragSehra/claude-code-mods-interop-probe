*.log
!probe/runs/*.log

# ---- Project runtime artifacts (regenerable; archived copies live in probe/runs/) ----
.lint-guard-trace.jsonl
.lint-guard-report.txt

# ---- Session / agent / hook state ----
.mimosa/
.claude/
.zcode/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors / IDEs ----
.idea/
.vscode/
*.swp

# ---- Build output (future-proofing; nothing builds here today) ----
dist/
build/
out/
coverage/
